{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunchlaunch",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "LunchRoom"
      },
      {
        "name": "PLACES",
        "class_name": "PlaceCatalog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LunchRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PlaceCatalog"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
